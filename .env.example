# MongoDB
MONGODB_URI=mongodb://localhost:27017/codeyoung-trial-booking

# Server
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Booking Config
SLOT_DURATION_MINUTES=30
